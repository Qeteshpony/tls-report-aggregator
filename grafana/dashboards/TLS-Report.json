      "pluginVersion": "11.6.1",
      "targets": [
        {
          "dataset": "tlsreport",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.domain AS `Sender Domain`,\n  o.name AS Organization,\n  COUNT(r.id) AS Reports,\n  SUM(r.successful) AS Success,\n  SUM(r.failure) AS Failure\nFROM\n  reports r\nJOIN\n  domains d ON r.senderdomain = d.id\nJOIN\n  organizations o ON r.organization = o.id\nWHERE\n  r.starttime >= $__timeFrom()\n  AND r.endtime <= $__timeTo()\nGROUP BY\n  d.domain, o.name\nORDER BY\n  Reports DESC;\n",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          },
          "table": "reports"
        }
      ],
      "title": "Reports by Sender-Domain",
      "type": "table"
    },
